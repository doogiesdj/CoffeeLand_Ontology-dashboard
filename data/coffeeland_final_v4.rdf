    <rdfs:label xml:lang="en">African Continental Free Trade Area</rdfs:label>
    <rdfs:comment xml:lang="en">Reduces intra-African tariffs; benefits Ethiopia Uganda Kenya Tanzania Rwanda</rdfs:comment>
