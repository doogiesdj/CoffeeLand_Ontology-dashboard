  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Central_America_Harvest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Season/Harvest"/>
    <rdfs:label xml:lang="ko">중미 수확기</rdfs:label>
    <rdfs:label xml:lang="en">Central America Harvest (Nov-Mar)</rdfs:label>
    <rdfs:comment xml:lang="en">Guatemala Honduras Costa Rica El Salvador Nicaragua washed Arabica</rdfs:comment>
    <cof:hasRegion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guatemala, Honduras, Costa Rica, El Salvador, Nicaragua</cof:hasRegion>
    <cof:hasMonths rdf:datatype="http://www.w3.org/2001/XMLSchema#string">November - March</cof:hasMonths>
    <cof:hasVolumeShare rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12% of global production</cof:hasVolumeShare>
    <cof:hasProcessingMethods rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fully Washed, Honey</cof:hasProcessingMethods>
    <cof:hasKeyVarieties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bourbon, Caturra, Catuai, Pacamara, SL28</cof:hasKeyVarieties>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High-altitude washed Arabicas known for bright acidity. Honduras is largest Central American producer. Guatemala Antigua and Costa Rica Tarrazu are benchmark origins.</cof:hasDescription>
  </rdf:Description>
