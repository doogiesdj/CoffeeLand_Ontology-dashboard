  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#CAFTA_DR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#TradeAgreement"/>
    <rdfs:label xml:lang="ko">DR-CAFTA 자유무역협정</rdfs:label>
    <rdfs:label xml:lang="en">CAFTA-DR Free Trade Agreement</rdfs:label>
    <rdfs:comment xml:lang="en">Eliminates tariffs on coffee from Central America and DR to the US</rdfs:comment>
    <cof:hasYearEstablished rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2006</cof:hasYearEstablished>
    <cof:hasMemberCountries rdf:datatype="http://www.w3.org/2001/XMLSchema#string">USA, Costa Rica, El Salvador, Guatemala, Honduras, Nicaragua, Dominican Republic</cof:hasMemberCountries>
    <cof:hasScope rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tariff elimination on agricultural goods including coffee</cof:hasScope>
    <cof:hasImpactOnCoffee rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zero tariffs on Central American coffee to US; boosted Honduras and Guatemala exports by 40%</cof:hasImpactOnCoffee>
    <cof:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In Force</cof:hasStatus>
  </rdf:Description>
