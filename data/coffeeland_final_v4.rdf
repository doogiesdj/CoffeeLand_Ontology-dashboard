  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Kenya_Main_Harvest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Season/Harvest"/>
    <rdfs:label xml:lang="ko">케냐 메인 수확기</rdfs:label>
    <rdfs:label xml:lang="en">Kenya Main Harvest (Oct-Dec)</rdfs:label>
    <rdfs:comment xml:lang="en">Washed Arabica SL28/SL34; graded by bean size AA AB PB</rdfs:comment>
    <cof:hasRegion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nyeri, Kiambu, Kirinyaga, Embu, Meru</cof:hasRegion>
    <cof:hasMonths rdf:datatype="http://www.w3.org/2001/XMLSchema#string">October - December</cof:hasMonths>
    <cof:hasVolumeShare rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1% of global production</cof:hasVolumeShare>
    <cof:hasProcessingMethods rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fully Washed (Kenya method: 72-hour fermentation)</cof:hasProcessingMethods>
    <cof:hasKeyVarieties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SL28, SL34, Ruiru 11, Batian</cof:hasKeyVarieties>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Renowned for bright, complex, blackcurrant-like acidity. Auction system at Nairobi Coffee Exchange. Graded by bean size: AA (screen 18+), AB, PB (peaberry). Small fly crop May-July.</cof:hasDescription>
  </rdf:Description>
