    <cof:hasVolumeShare rdf:datatype="http://www.w3.org/2001/XMLSchema#string">8% of global production</cof:hasVolumeShare>
    <cof:hasProcessingMethods rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fully Washed</cof:hasProcessingMethods>
