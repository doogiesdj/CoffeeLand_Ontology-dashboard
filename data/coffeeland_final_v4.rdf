    <rdfs:label xml:lang="en">Ready-to-Drink Coffee Consumer</rdfs:label>
    <rdfs:comment xml:lang="en">Canned/bottled coffee; large market in Japan US South Korea</rdfs:comment>
    <cof:hasMarketShare rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-8%</cof:hasMarketShare>
