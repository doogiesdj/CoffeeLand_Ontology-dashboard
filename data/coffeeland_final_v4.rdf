  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#ICE_Robusta_London_Contract">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Price"/>
    <rdfs:label xml:lang="ko">ICE 로부스타 런던 선물</rdfs:label>
    <rdfs:label xml:lang="en">ICE Robusta London Futures</rdfs:label>
    <rdfs:comment xml:lang="en">Global benchmark for Robusta; ICE Futures Europe London</rdfs:comment>
    <cof:hasExchange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ICE Futures Europe (London)</cof:hasExchange>
    <cof:hasContractUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10 metric tonnes</cof:hasContractUnit>
    <cof:hasPriceRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1,800-5,800 USD/tonne</cof:hasPriceRange>
    <cof:hasCurrency rdf:datatype="http://www.w3.org/2001/XMLSchema#string">USD</cof:hasCurrency>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The global benchmark for Robusta coffee. Key reference for Vietnamese, Indonesian, and West African Robusta pricing.</cof:hasDescription>
    <cof:hasRelevance rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Used by Robusta traders; basis for instant coffee raw material pricing</cof:hasRelevance>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#ASEAN_Free_Trade_Area">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#TradeAgreement"/>
    <rdfs:label xml:lang="ko">아세안자유무역지대</rdfs:label>
    <rdfs:label xml:lang="en">ASEAN Free Trade Area</rdfs:label>
    <rdfs:comment xml:lang="en">Reduces tariffs among SE Asian nations for coffee from Indonesia and Vietnam</rdfs:comment>
    <cof:hasYearEstablished rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1992</cof:hasYearEstablished>
    <cof:hasMemberCountries rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indonesia, Vietnam, Philippines, Thailand, Malaysia, Singapore, + 4 others</cof:hasMemberCountries>
    <cof:hasScope rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Common Effective Preferential Tariff for ASEAN members</cof:hasScope>
    <cof:hasImpactOnCoffee rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reduces tariffs on Robusta and Arabica between Indonesia and Vietnam; enables regional blending</cof:hasImpactOnCoffee>
    <cof:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In Force</cof:hasStatus>
  </rdf:Description>
