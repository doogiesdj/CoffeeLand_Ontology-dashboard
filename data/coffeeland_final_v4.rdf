  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#PNG_Harvest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Season/Harvest"/>
    <rdfs:label xml:lang="ko">파푸아뉴기니 수확기</rdfs:label>
    <rdfs:label xml:lang="en">Papua New Guinea Harvest (Apr-Sep)</rdfs:label>
    <rdfs:comment xml:lang="en">Smallholder washed Arabica; peak May-Aug</rdfs:comment>
    <cof:hasRegion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Western Highlands, Eastern Highlands, Simbu</cof:hasRegion>
    <cof:hasMonths rdf:datatype="http://www.w3.org/2001/XMLSchema#string">April - September</cof:hasMonths>
    <cof:hasVolumeShare rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1% of global production</cof:hasVolumeShare>
    <cof:hasProcessingMethods rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fully Washed, Semi-washed</cof:hasProcessingMethods>
    <cof:hasKeyVarieties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Typica, Arusha, Bourbon</cof:hasKeyVarieties>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Smallholder-dominated (95% of production from gardens under 1 hectare). Increasing specialty recognition for clean, bright highland coffees. Sigri and Goroka estates are benchmark producers.</cof:hasDescription>
  </rdf:Description>
