    <rdfs:label xml:lang="ko">EU-베트남 FTA</rdfs:label>
    <rdfs:label xml:lang="en">EU-Vietnam Free Trade Agreement</rdfs:label>
    <rdfs:comment xml:lang="en">Eliminates tariffs on Vietnamese Robusta exports to EU</rdfs:comment>
    <cof:hasYearEstablished rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</cof:hasYearEstablished>
    <cof:hasMemberCountries rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EU, Vietnam</cof:hasMemberCountries>
    <cof:hasScope rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Comprehensive FTA eliminating tariffs over transition period</cof:hasScope>
    <cof:hasImpactOnCoffee rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phases out EU tariffs on Vietnamese Robusta; Vietnam is world #2 producer</cof:hasImpactOnCoffee>
