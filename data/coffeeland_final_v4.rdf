    <rdfs:label xml:lang="en">Specialty Spot Differential</rdfs:label>
    <rdfs:comment xml:lang="en">Specialty lots trade at +20 to +150 cents/lb above C-market</rdfs:comment>
    <cof:hasExchange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Private contracts / spot market</cof:hasExchange>
    <cof:hasContractUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Negotiated per lot</cof:hasContractUnit>
    <cof:hasPriceRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">+20 to +150 cents/lb above C-market</cof:hasPriceRange>
    <cof:hasCurrency rdf:datatype="http://www.w3.org/2001/XMLSchema#string">USD</cof:hasCurrency>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specialty coffees (SCA 80+) trade at a positive differential above the ICE C-market benchmark. Exceptional lots (90+ score) can command +$5-20/lb.</cof:hasDescription>
    <cof:hasRelevance rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Determines actual prices paid for high-quality single-origin lots</cof:hasRelevance>
  </rdf:Description>
