  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Indonesia_Sumatra_Harvest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Season/Harvest"/>
    <rdfs:label xml:lang="ko">인도네시아 수마트라 수확기</rdfs:label>
    <rdfs:label xml:lang="en">Indonesia Sumatra Harvest (Sep-Dec)</rdfs:label>
    <rdfs:comment xml:lang="en">Mandheling Gayo Arabica; wet-hulled giling basah processing</rdfs:comment>
    <cof:hasRegion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aceh (Gayo), North Sumatra (Mandheling), Lampung</cof:hasRegion>
    <cof:hasMonths rdf:datatype="http://www.w3.org/2001/XMLSchema#string">September - December (Arabica); April - August (Robusta)</cof:hasMonths>
    <cof:hasVolumeShare rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6% of global production</cof:hasVolumeShare>
    <cof:hasProcessingMethods rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Giling Basah (Wet-hulled), Natural</cof:hasProcessingMethods>
    <cof:hasKeyVarieties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Typica, Catimor, S-Lini (Arabica); Robusta</cof:hasKeyVarieties>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unique wet-hulled processing creates distinctive earthy, herbal profile. Sumatra Mandheling and Gayo are premium grades. Java and Sulawesi produce washed Arabica.</cof:hasDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Home_Brewing_Hobbyist">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
