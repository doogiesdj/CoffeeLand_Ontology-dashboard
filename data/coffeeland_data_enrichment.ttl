cof:MS_LatAmEspressoService a owl:NamedIndividual, cof:MaintenanceService ;
    cof:hasName "LatAm Espresso Service"^^xsd:string ; cof:isHeadquarteredIn cof:Colombia ;
    cof:hasCity "Bogotá"^^xsd:string ;
    cof:hasSpecialty "Espresso Machine Repair & Water Filtration Setup"^^xsd:string ;
    rdfs:comment "보고타 기반 서비스사로 중남미 카페 체인 대상 머신 수리와 현지 경수(硬水) 대응 정수 시스템 설치를 전문으로 함."@ko .
