  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Colombia_Mitaca_Harvest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Season/Harvest"/>
    <rdfs:label xml:lang="ko">콜롬비아 미타카 수확기</rdfs:label>
    <rdfs:label xml:lang="en">Colombia Mitaca Harvest (Apr-Jun)</rdfs:label>
    <rdfs:comment xml:lang="en">Secondary harvest enabling year-round Colombian coffee supply</rdfs:comment>
    <cof:hasRegion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Southern departments (Narino, Huila)</cof:hasRegion>
    <cof:hasMonths rdf:datatype="http://www.w3.org/2001/XMLSchema#string">April - June</cof:hasMonths>
    <cof:hasVolumeShare rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3% of global production</cof:hasVolumeShare>
    <cof:hasProcessingMethods rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fully Washed</cof:hasProcessingMethods>
    <cof:hasKeyVarieties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Caturra, Castillo</cof:hasKeyVarieties>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Secondary harvest (mitaca/traviesa) enabling Colombia to ship fresh coffee year-round. Smaller volume but often higher cup quality from slower cherry maturation.</cof:hasDescription>
  </rdf:Description>
