  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Espresso_Purist">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
