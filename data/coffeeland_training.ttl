@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cof:  <http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#> .

# ================================================================
# 커피랜드 온톨로지 — 3단계: 교육 과정(커리큘럼) 지도
# 자동 생성 파일 — 직접 고치지 말고 scripts/build_training_ttl.py 를 수정한 뒤
#   python scripts/build_training_ttl.py
# 로 다시 만드세요. (tests/test_training.py 가 최신 상태인지 검사합니다)
#
# 출처: dashboard.html 의 TrainingProgram 목록 (topics / facts / 기본 정보)
# ================================================================

cof:Skill a owl:Class ;
    rdfs:subClassOf cof:ShopOperation ;
    rdfs:label "기술(역량)"@ko , "Skill"@en ;
    rdfs:comment "교육 과정에서 배우는 역량. relatesToConcept 로 온톨로지의 관련 클래스와 연결된다."@ko .

cof:teachesSkill a owl:ObjectProperty ;
    rdfs:domain cof:TrainingProgram ; rdfs:range cof:Skill ;
    rdfs:label "가르치는 기술"@ko .

cof:hasPrerequisite a owl:ObjectProperty ;
    rdfs:domain cof:TrainingProgram ; rdfs:range cof:TrainingProgram ;
    rdfs:label "선수 과정"@ko ;
    rdfs:comment "이 과정을 듣기 전에 이수·취득해야 하는 과정 (원문 facts 근거)."@ko .

cof:relatesToConcept a owl:ObjectProperty ;
    rdfs:domain cof:Skill ;
    rdfs:label "관련 개념"@ko ;
    rdfs:comment "기술이 다루는 온톨로지 클래스 (OWL 2 punning: 클래스 IRI 를 값으로 사용)."@ko .

cof:hasSkillArea a owl:DatatypeProperty ; rdfs:domain cof:Skill ; rdfs:range xsd:string ;
    rdfs:comment "Fundamentals | Brewing | Milk | Sensory | Roasting | GreenCoffee | Equipment | Service | Operations | Safety"@ko .
cof:hasProgramName a owl:DatatypeProperty ; rdfs:domain cof:TrainingProgram ; rdfs:range xsd:string .
cof:hasProgramOrigin a owl:DatatypeProperty ; rdfs:domain cof:TrainingProgram ; rdfs:range xsd:string ;
    rdfs:comment "InHouse(사내) | Domestic(국내) | International(해외)"@ko .
cof:hasProgramLevel a owl:DatatypeProperty ; rdfs:domain cof:TrainingProgram ; rdfs:range xsd:string .
cof:hasModuleCount a owl:DatatypeProperty ; rdfs:domain cof:TrainingProgram ; rdfs:range xsd:integer .
cof:hasDuration a owl:DatatypeProperty ; rdfs:domain cof:TrainingProgram ; rdfs:range xsd:string .
cof:hasTopic a owl:DatatypeProperty ; rdfs:domain cof:TrainingProgram ; rdfs:range xsd:string ;
    rdfs:comment "원문 주제 표기 그대로 (teachesSkill 분류의 근거)."@ko .
cof:hasWebsite a owl:DatatypeProperty ; rdfs:domain cof:TrainingProgram ; rdfs:range xsd:anyURI .

# ── 기술 ──
cof:SK_CoffeeFundamentals a owl:NamedIndividual , cof:Skill ;
    rdfs:label "커피 기초 지식"@ko , "Coffee Fundamentals"@en ;
    cof:hasSkillArea "Fundamentals"^^xsd:string ;
    cof:relatesToConcept cof:CoffeeVariety , cof:ProcessingMethod , cof:RoastLevel , cof:BrewMethod .
cof:SK_CoffeeOrigins a owl:NamedIndividual , cof:Skill ;
    rdfs:label "산지 이해"@ko , "Coffee Origins"@en ;
    cof:hasSkillArea "Fundamentals"^^xsd:string ;
    cof:relatesToConcept cof:Country , cof:Farm , cof:Harvest , cof:CoffeeVariety .
cof:SK_CoffeeTerminology a owl:NamedIndividual , cof:Skill ;
    rdfs:label "커피 용어(영어)"@ko , "Coffee Terminology"@en ;
    cof:hasSkillArea "Fundamentals"^^xsd:string .
cof:SK_EspressoExtraction a owl:NamedIndividual , cof:Skill ;
    rdfs:label "에스프레소 추출"@ko , "Espresso Extraction"@en ;
    cof:hasSkillArea "Brewing"^^xsd:string ;
    cof:relatesToConcept cof:BrewMethod , cof:EspressoMachine , cof:Grinder , cof:Recipe .
cof:SK_EspressoCalibration a owl:NamedIndividual , cof:Skill ;
    rdfs:label "추출 보정(캘리브레이션)"@ko , "Espresso Calibration"@en ;
    cof:hasSkillArea "Brewing"^^xsd:string ;
    cof:relatesToConcept cof:BrewMethod , cof:EspressoMachine , cof:Grinder , cof:Recipe .
cof:SK_GrindProfile a owl:NamedIndividual , cof:Skill ;
    rdfs:label "분쇄 프로파일"@ko , "Grind Profile"@en ;
    cof:hasSkillArea "Brewing"^^xsd:string ;
    cof:relatesToConcept cof:Grinder .
cof:SK_ExtractionTheory a owl:NamedIndividual , cof:Skill ;
    rdfs:label "추출 이론·설계"@ko , "Extraction Theory & Design"@en ;
    cof:hasSkillArea "Brewing"^^xsd:string ;
    cof:relatesToConcept cof:BrewMethod , cof:Recipe .
cof:SK_FilterBrewing a owl:NamedIndividual , cof:Skill ;
    rdfs:label "핸드드립·추출 기구"@ko , "Filter Brewing & Brew Tools"@en ;
    cof:hasSkillArea "Brewing"^^xsd:string ;
    cof:relatesToConcept cof:BrewMethod , cof:Recipe .
cof:SK_MilkSteaming a owl:NamedIndividual , cof:Skill ;
    rdfs:label "우유 스티밍"@ko , "Milk Steaming"@en ;
    cof:hasSkillArea "Milk"^^xsd:string ;
    cof:relatesToConcept cof:Milk , cof:EspressoMachine .
cof:SK_LatteArt a owl:NamedIndividual , cof:Skill ;
    rdfs:label "라떼아트"@ko , "Latte Art"@en ;
    cof:hasSkillArea "Milk"^^xsd:string ;
    cof:relatesToConcept cof:Milk , cof:BeverageMenu .
cof:SK_Cupping a owl:NamedIndividual , cof:Skill ;
    rdfs:label "커핑"@ko , "Cupping"@en ;
    cof:hasSkillArea "Sensory"^^xsd:string ;
    cof:relatesToConcept cof:FlavorNote , cof:QualityGrade , cof:CuppingCompetition .
cof:SK_SensorySkills a owl:NamedIndividual , cof:Skill ;
    rdfs:label "감각 훈련(후각·미각·유기산)"@ko , "Sensory Skills"@en ;
    cof:hasSkillArea "Sensory"^^xsd:string ;
    cof:relatesToConcept cof:FlavorNote .
cof:SK_FlavorEvaluation a owl:NamedIndividual , cof:Skill ;
    rdfs:label "향미 평가·프로파일링"@ko , "Flavor Evaluation"@en ;
    cof:hasSkillArea "Sensory"^^xsd:string ;
    cof:relatesToConcept cof:FlavorNote , cof:ProcessingMethod , cof:RoastLevel .
cof:SK_CoffeeValueAssessment a owl:NamedIndividual , cof:Skill ;
    rdfs:label "CVA 품질 평가"@ko , "Coffee Value Assessment"@en ;
    cof:hasSkillArea "Sensory"^^xsd:string ;
    cof:relatesToConcept cof:FlavorNote , cof:QualityGrade .
cof:SK_RoastLevelIdentification a owl:NamedIndividual , cof:Skill ;
    rdfs:label "로스트 레벨 식별"@ko , "Roast Level Identification"@en ;
    cof:hasSkillArea "Sensory"^^xsd:string ;
    cof:relatesToConcept cof:RoastLevel .
cof:SK_Roasting a owl:NamedIndividual , cof:Skill ;
    rdfs:label "로스팅 이론·프로파일"@ko , "Roasting"@en ;
    cof:hasSkillArea "Roasting"^^xsd:string ;
    cof:relatesToConcept cof:RoastLevel , cof:RoasterMachine .
cof:SK_GreenCoffeeGrading a owl:NamedIndividual , cof:Skill ;
    rdfs:label "생두 분류·결점두 그레이딩"@ko , "Green Coffee Grading"@en ;
    cof:hasSkillArea "GreenCoffee"^^xsd:string ;
    cof:relatesToConcept cof:QualityGrade , cof:CoffeeVariety .
cof:SK_Processing a owl:NamedIndividual , cof:Skill ;
    rdfs:label "가공 방식·품질관리"@ko , "Processing"@en ;
    cof:hasSkillArea "GreenCoffee"^^xsd:string ;
    cof:relatesToConcept cof:ProcessingMethod , cof:ProcessingMill .
cof:SK_EquipmentMaintenance a owl:NamedIndividual , cof:Skill ;
    rdfs:label "장비 관리·정비"@ko , "Equipment Maintenance"@en ;
    cof:hasSkillArea "Equipment"^^xsd:string ;
    cof:relatesToConcept cof:EspressoMachine , cof:Grinder , cof:MaintenanceService .
cof:SK_WaterQuality a owl:NamedIndividual , cof:Skill ;
    rdfs:label "물·수질 관리"@ko , "Water Quality"@en ;
    cof:hasSkillArea "Equipment"^^xsd:string ;
    cof:relatesToConcept cof:WaterFilter .
cof:SK_CustomerService a owl:NamedIndividual , cof:Skill ;
    rdfs:label "고객 서비스"@ko , "Customer Service"@en ;
    cof:hasSkillArea "Service"^^xsd:string ;
    cof:relatesToConcept cof:Consumer .
cof:SK_Sales a owl:NamedIndividual , cof:Skill ;
    rdfs:label "판매·업셀링"@ko , "Sales & Upselling"@en ;
    cof:hasSkillArea "Service"^^xsd:string ;
    cof:relatesToConcept cof:BeverageMenu .
cof:SK_MenuPreparation a owl:NamedIndividual , cof:Skill ;
    rdfs:label "메뉴 조리"@ko , "Menu Preparation"@en ;
    cof:hasSkillArea "Operations"^^xsd:string ;
    cof:relatesToConcept cof:Recipe , cof:BeverageMenu , cof:Ingredient .
cof:SK_CafeOperations a owl:NamedIndividual , cof:Skill ;
    rdfs:label "카페 실무·운영"@ko , "Cafe Operations"@en ;
    cof:hasSkillArea "Operations"^^xsd:string ;
    cof:relatesToConcept cof:BeverageMenu , cof:Ingredient , cof:Consumable .
cof:SK_POSOperation a owl:NamedIndividual , cof:Skill ;
    rdfs:label "POS 사용"@ko , "POS Operation"@en ;
    cof:hasSkillArea "Operations"^^xsd:string ;
    cof:relatesToConcept cof:PosSystem .
cof:SK_Instruction a owl:NamedIndividual , cof:Skill ;
    rdfs:label "교육·지도"@ko , "Instruction"@en ;
    cof:hasSkillArea "Operations"^^xsd:string ;
    cof:relatesToConcept cof:TrainingProgram .
cof:SK_CompetitionPrep a owl:NamedIndividual , cof:Skill ;
    rdfs:label "대회 준비"@ko , "Competition Preparation"@en ;
    cof:hasSkillArea "Operations"^^xsd:string .
cof:SK_FoodSafety a owl:NamedIndividual , cof:Skill ;
    rdfs:label "식품 위생·안전"@ko , "Food Safety & Hygiene"@en ;
    cof:hasSkillArea "Safety"^^xsd:string ;
    cof:relatesToConcept cof:Ingredient .

# ── 교육 과정 ──
cof:TP_BaristaBasics a owl:NamedIndividual , cof:TrainingProgram ;
    rdfs:label "Barista Basics" ;
    cof:hasProgramName "Barista Basics"^^xsd:string ;
    cof:hasProgramOrigin "InHouse"^^xsd:string ;
    cof:hasProgramLevel "Beginner"^^xsd:string ;
    cof:hasDuration "2 Weeks"^^xsd:string ;
    cof:hasDescription "신규 입사 바리스타가 매장 실무에 투입되기 전 이수하는 사내 기본 과정. 에스프레소 추출과 우유 스티밍 등 핵심 기술을 2주에 걸쳐 익힌다."^^xsd:string ;
    cof:hasModuleCount 5 ;
    cof:hasTopic "Espresso Fundamentals"^^xsd:string , "Milk Steaming"^^xsd:string , "Coffee Origins"^^xsd:string , "Equipment Care"^^xsd:string , "POS Usage"^^xsd:string ;
    cof:teachesSkill cof:SK_EspressoExtraction , cof:SK_MilkSteaming , cof:SK_CoffeeOrigins , cof:SK_EquipmentMaintenance , cof:SK_POSOperation .
cof:TP_AdvancedEspresso a owl:NamedIndividual , cof:TrainingProgram ;
    rdfs:label "Advanced Espresso" ;
    cof:hasProgramName "Advanced Espresso"^^xsd:string ;
    cof:hasProgramOrigin "InHouse"^^xsd:string ;
    cof:hasProgramLevel "Advanced"^^xsd:string ;
    cof:hasDuration "4 Weeks"^^xsd:string ;
    cof:hasDescription "추출 변수를 스스로 설계·보정할 수 있는 숙련 바리스타 양성 과정. 커핑과 향미 프로파일링을 포함하며 대회 준비 과정까지 다룬다."^^xsd:string ;
    cof:hasModuleCount 8 ;
    cof:hasTopic "Espresso Calibration"^^xsd:string , "Grind Profile"^^xsd:string , "Latte Art"^^xsd:string , "Cupping"^^xsd:string , "Flavor Profiling"^^xsd:string , "Competition Prep"^^xsd:string ;
    cof:teachesSkill cof:SK_EspressoCalibration , cof:SK_GrindProfile , cof:SK_LatteArt , cof:SK_Cupping , cof:SK_FlavorEvaluation , cof:SK_CompetitionPrep ;
    cof:hasPrerequisite cof:TP_BaristaBasics .
cof:TP_CustomerService a owl:NamedIndividual , cof:TrainingProgram ;
    rdfs:label "Customer Service" ;
    cof:hasProgramName "Customer Service"^^xsd:string ;
    cof:hasProgramOrigin "InHouse"^^xsd:string ;
    cof:hasProgramLevel "Beginner"^^xsd:string ;
    cof:hasDuration "1 Week"^^xsd:string ;
    cof:hasDescription "응대 화법과 컴플레인 처리, 업셀링을 다루는 단기 서비스 과정. 전 직군이 공통으로 이수한다."^^xsd:string ;
    cof:hasModuleCount 3 ;
    cof:hasTopic "Communication Skills"^^xsd:string , "Complaint Handling"^^xsd:string , "Upselling Techniques"^^xsd:string ;
    cof:teachesSkill cof:SK_CustomerService , cof:SK_Sales .
cof:TP_FoodSafety a owl:NamedIndividual , cof:TrainingProgram ;
    rdfs:label "Food Safety & Hygiene" ;
    cof:hasProgramName "Food Safety & Hygiene"^^xsd:string ;
    cof:hasProgramOrigin "InHouse"^^xsd:string ;
    cof:hasProgramLevel "Mandatory"^^xsd:string ;
    cof:hasDuration "3 Weeks"^^xsd:string ;
    cof:hasDescription "HACCP 원칙과 알레르겐 관리, 온도·세척 관리를 다루는 필수 위생 과정. 이수 시 사내 인증이 부여된다."^^xsd:string ;
    cof:hasModuleCount 6 ;
    cof:hasTopic "HACCP Principles"^^xsd:string , "Allergen Awareness"^^xsd:string , "Temperature Control"^^xsd:string , "Cleaning Procedures"^^xsd:string , "Personal Hygiene"^^xsd:string , "Certification"^^xsd:string ;
    cof:teachesSkill cof:SK_FoodSafety .
cof:TP_KCA_Barista2 a owl:NamedIndividual , cof:TrainingProgram ;
    rdfs:label "바리스타 2급 (KCA Barista Level 2)" ;
    cof:hasProgramName "바리스타 2급 (KCA Barista Level 2)"^^xsd:string ;
    cof:hasProgramOrigin "Domestic"^^xsd:string ;
    cof:hasProgramLevel "Beginner"^^xsd:string ;
    cof:hasDuration "필기 + 실기 검정"^^xsd:string ;
    cof:hasDescription "국내에서 가장 널리 통용되는 바리스타 입문 민간자격. 협회 인증 교육기관에서 과정을 이수한 뒤 필기와 실기 검정을 각각 치른다. 상위 자격인 바리스타 1급의 응시 전제 조건이기도 하다."^^xsd:string ;
    cof:hasModuleCount 5 ;
    cof:hasProvider "(사)한국커피협회 (KCA)"^^xsd:string ;
    cof:hasWebsite "https://www.kca-coffee.org/cms/FrCon/index.do?MENU_ID=610"^^xsd:anyURI ;
    cof:hasTopic "커피학 개론"^^xsd:string , "에스프레소 추출"^^xsd:string , "우유 스티밍"^^xsd:string , "위생·매장 관리"^^xsd:string , "서비스 기술"^^xsd:string ;
    cof:teachesSkill cof:SK_CoffeeFundamentals , cof:SK_EspressoExtraction , cof:SK_MilkSteaming , cof:SK_FoodSafety , cof:SK_CafeOperations , cof:SK_CustomerService .
cof:TP_KCA_Barista1 a owl:NamedIndividual , cof:TrainingProgram ;
    rdfs:label "바리스타 1급 (KCA Barista Level 1)" ;
    cof:hasProgramName "바리스타 1급 (KCA Barista Level 1)"^^xsd:string ;
    cof:hasProgramOrigin "Domestic"^^xsd:string ;
    cof:hasProgramLevel "Advanced"^^xsd:string ;
    cof:hasDuration "인증기관 교육 24시간 이상"^^xsd:string ;
    cof:hasDescription "바리스타 2급 취득자가 도전하는 상위 자격. 로스팅과 향미 평가까지 출제 범위가 넓어지고, 실기는 평가자 2명이 기술적·감각적 항목을 함께 채점한다."^^xsd:string ;
    cof:hasModuleCount 6 ;
    cof:hasProvider "(사)한국커피협회 (KCA)"^^xsd:string ;
    cof:hasWebsite "https://www.kca-coffee.org/cms/FrCon/index.do?MENU_ID=620"^^xsd:anyURI ;
    cof:hasTopic "커피학 개론"^^xsd:string , "로스팅·향미 평가"^^xsd:string , "추출 이론"^^xsd:string , "에스프레소·카푸치노 시연"^^xsd:string , "서비스 기술"^^xsd:string , "영어 커피 용어"^^xsd:string ;
    cof:teachesSkill cof:SK_CoffeeFundamentals , cof:SK_Roasting , cof:SK_FlavorEvaluation , cof:SK_ExtractionTheory , cof:SK_EspressoExtraction , cof:SK_MilkSteaming , cof:SK_CustomerService , cof:SK_CoffeeTerminology ;
    cof:hasPrerequisite cof:TP_KCA_Barista2 .
cof:TP_KCA_CoffeeInstructor a owl:NamedIndividual , cof:TrainingProgram ;
    rdfs:label "커피지도사 1·2급 (Coffee Instructor)" ;
    cof:hasProgramName "커피지도사 1·2급 (Coffee Instructor)"^^xsd:string ;
    cof:hasProgramOrigin "Domestic"^^xsd:string ;
    cof:hasProgramLevel "Instructor"^^xsd:string ;
    cof:hasDuration "전 과정 72시간"^^xsd:string ;
    cof:hasDescription "커피를 \"가르치는 사람\"을 양성하는 과정평가형 자격. 홈카페마스터부터 커피지도사 1급까지 총 72시간을 단계적으로 이수하며, 추출 설계와 메뉴 조리·고객 서비스를 지도하는 역량을 평가한다."^^xsd:string ;
    cof:hasModuleCount 6 ;
    cof:hasProvider "(사)한국커피협회 (KCA)"^^xsd:string ;
    cof:hasWebsite "https://www.kca-coffee.org/cms/FrCon/index.do?MENU_ID=660"^^xsd:anyURI ;
    cof:hasTopic "홈카페마스터 18h"^^xsd:string , "커피지도사 2급 27h"^^xsd:string , "커피지도사 1급 27h"^^xsd:string , "추출 설계"^^xsd:string , "메뉴 조리 지도"^^xsd:string , "고객 서비스 지도"^^xsd:string ;
    cof:teachesSkill cof:SK_ExtractionTheory , cof:SK_MenuPreparation , cof:SK_Instruction , cof:SK_CustomerService ;
    cof:hasPrerequisite cof:TP_KCA_HomeCafeMaster .
cof:TP_KCA_RoastMaster a owl:NamedIndividual , cof:TrainingProgram ;
    rdfs:label "로스트마스터 (Roast Master)" ;
    cof:hasProgramName "로스트마스터 (Roast Master)"^^xsd:string ;
    cof:hasProgramOrigin "Domestic"^^xsd:string ;
    cof:hasProgramLevel "Intermediate"^^xsd:string ;
    cof:hasDuration "이론 + 실습 과정"^^xsd:string ;
    cof:hasDescription "로스팅 기술의 표준을 제시하고 커피 가공 기술의 이해도를 검증하는 심사평가형 자격. 늘어나는 홈 로스터와 소규모 로스터리 카페 창업자를 주요 대상으로 한다."^^xsd:string ;
    cof:hasModuleCount 6 ;
    cof:hasProvider "(사)한국커피협회 (KCA)"^^xsd:string ;
    cof:hasWebsite "https://www.kca-coffee.org/cms/FrCon/index.do?MENU_ID=670"^^xsd:anyURI ;
    cof:hasTopic "생두 분류"^^xsd:string , "로스팅 이론"^^xsd:string , "로스트 프로파일"^^xsd:string , "결점두 식별"^^xsd:string , "향미 평가"^^xsd:string , "로스터리 카페 운영"^^xsd:string ;
    cof:teachesSkill cof:SK_GreenCoffeeGrading , cof:SK_Roasting , cof:SK_FlavorEvaluation , cof:SK_CafeOperations .
cof:TP_KCA_HomeCafeMaster a owl:NamedIndividual , cof:TrainingProgram ;
    rdfs:label "홈카페마스터 (Home Cafe Master)" ;
    cof:hasProgramName "홈카페마스터 (Home Cafe Master)"^^xsd:string ;
    cof:hasProgramOrigin "Domestic"^^xsd:string ;
    cof:hasProgramLevel "Beginner"^^xsd:string ;
    cof:hasDuration "18시간"^^xsd:string ;
    cof:hasDescription "가정이나 사무실에서 수준 높은 커피를 다룰 수 있게 하는 입문 과정. 원두커피를 즐기는 일반인에게 올바른 커피 기술을 알리는 것이 목적이며, 이수자는 커피지도사 1급에 도전할 자격을 얻는다."^^xsd:string ;
    cof:hasModuleCount 4 ;
    cof:hasProvider "(사)한국커피협회 (KCA)"^^xsd:string ;
    cof:hasWebsite "https://www.kca-coffee.org/cms/FrCon/index.do?MENU_ID=2060"^^xsd:anyURI ;
    cof:hasTopic "커피학 개론"^^xsd:string , "추출 기구 활용"^^xsd:string , "핸드드립"^^xsd:string , "향미 평가"^^xsd:string ;
    cof:teachesSkill cof:SK_CoffeeFundamentals , cof:SK_FilterBrewing , cof:SK_FlavorEvaluation .
