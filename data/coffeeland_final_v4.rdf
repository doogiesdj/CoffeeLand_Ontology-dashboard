  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Specialty_Coffee_Consumer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Consumer"/>
    <rdfs:label xml:lang="ko">스페셜티 커피 소비자</rdfs:label>
    <rdfs:label xml:lang="en">Specialty Coffee Consumer</rdfs:label>
    <rdfs:comment xml:lang="en">Seeks SCA 80+ coffees; values traceability and brewing method</rdfs:comment>
    <cof:hasMarketShare rdf:datatype="http://www.w3.org/2001/XMLSchema#string">8-12%</cof:hasMarketShare>
    <cof:hasPriceSensitivity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Low</cof:hasPriceSensitivity>
    <cof:hasPreferredGrade rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCA 80+ Specialty Grade</cof:hasPreferredGrade>
    <cof:hasKeyMarkets rdf:datatype="http://www.w3.org/2001/XMLSchema#string">USA, Japan, South Korea, Australia, Scandinavia</cof:hasKeyMarkets>
    <cof:hasGrowthTrend rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Growing 10-15% annually</cof:hasGrowthTrend>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Discerning consumers seeking single-origin, micro-lot coffees scoring 80+ on SCA scale. Values transparency, direct trade, and artisanal roasting. Willing to pay USD 15-50/kg for exceptional lots.</cof:hasDescription>
  </rdf:Description>
