  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#ICE_Arabica_C_Contract">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Price"/>
    <rdfs:label xml:lang="ko">ICE 아라비카 C 선물</rdfs:label>
    <rdfs:label xml:lang="en">ICE Arabica C Futures Contract</rdfs:label>
    <rdfs:comment xml:lang="en">Global benchmark for washed Arabica; ICE Futures US New York</rdfs:comment>
    <cof:hasExchange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ICE Futures US (New York)</cof:hasExchange>
    <cof:hasContractUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">37,500 lbs (approx. 17 tonnes)</cof:hasContractUnit>
    <cof:hasPriceRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">150-430 US cents/lb</cof:hasPriceRange>
    <cof:hasCurrency rdf:datatype="http://www.w3.org/2001/XMLSchema#string">USD</cof:hasCurrency>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The global benchmark for washed Arabica coffee. Most-referenced price in the coffee industry. Delivery months: March, May, July, September, December.</cof:hasDescription>
    <cof:hasRelevance rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Used by all Arabica traders globally; basis for differential pricing</cof:hasRelevance>
  </rdf:Description>
