    <rdfs:label xml:lang="en">Brazil Santos No.4 Differential</rdfs:label>
    <rdfs:comment xml:lang="en">Benchmark for Brazilian natural Arabica FOB Santos</rdfs:comment>
    <cof:hasExchange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FOB Santos (Brazil spot market)</cof:hasExchange>
    <cof:hasContractUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Per container (typically 37,500 lbs)</cof:hasContractUnit>
    <cof:hasPriceRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-30 to +15 cents/lb vs C-market</cof:hasPriceRange>
