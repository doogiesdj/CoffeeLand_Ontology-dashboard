    <cof:hasImpactOnCoffee rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Facilitates cross-border coffee trade in Africa; benefits Ethiopian, Kenyan, Ugandan exports</cof:hasImpactOnCoffee>
    <cof:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Active</cof:hasStatus>
  </rdf:Description>
