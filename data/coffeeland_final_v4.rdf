    <rdfs:label xml:lang="en">Colombia Main Harvest (Sep-Dec)</rdfs:label>
    <rdfs:comment xml:lang="en">Principal harvest of washed Arabica from Huila Narino Antioquia</rdfs:comment>
    <cof:hasRegion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Huila, Narino, Antioquia, Tolima, Cauca</cof:hasRegion>
