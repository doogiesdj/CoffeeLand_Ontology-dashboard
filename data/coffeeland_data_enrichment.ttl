# ================================================================
# 13. Consumable / Ingredient 보강 — 매장 소모품·부재료 카테고리가
#     클래스당 2~5개 수준으로 빈약해 실사용 규격·소재 기준으로 보강.
# ================================================================

cof:hasSustainabilityNote a owl:DatatypeProperty ; rdfs:domain cof:Consumable ; rdfs:range xsd:string ;
    rdfs:label "친환경 특성"@ko ; rdfs:label "Sustainability Note"@en .
cof:hasCapacityValue a owl:DatatypeProperty ; rdfs:domain cof:Consumable ; rdfs:range xsd:string ;
    rdfs:label "용량/규격"@ko ; rdfs:label "Capacity/Size"@en .
cof:hasCaloriesPerServing a owl:DatatypeProperty ; rdfs:domain cof:Ingredient ; rdfs:range xsd:integer ;
    rdfs:label "1회 제공량당 칼로리"@ko ; rdfs:label "Calories per Serving"@en .

