    <cof:hasPriceSensitivity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Low to Medium</cof:hasPriceSensitivity>
    <cof:hasPreferredGrade rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specialty Grade SCA 82+</cof:hasPreferredGrade>
    <cof:hasKeyMarkets rdf:datatype="http://www.w3.org/2001/XMLSchema#string">USA, Japan, South Korea, Australia, Northern Europe</cof:hasKeyMarkets>
    <cof:hasGrowthTrend rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Growing 20%+ annually</cof:hasGrowthTrend>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Invests in equipment: pour-over drippers, AeroPress, home espresso machines, precision grinders. Buys whole-bean from local roasters. Follows brewing ratios and water temperature protocols.</cof:hasDescription>
  </rdf:Description>
