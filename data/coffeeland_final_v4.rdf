  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Peru_Harvest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Season/Harvest"/>
    <rdfs:label xml:lang="ko">페루 수확기</rdfs:label>
    <rdfs:label xml:lang="en">Peru Harvest (Apr-Sep)</rdfs:label>
    <rdfs:comment xml:lang="en">Organic Fair Trade Arabica from smallholder farms; peak Jun-Aug</rdfs:comment>
    <cof:hasRegion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cajamarca, San Martin, Junin, Cusco, Amazonas</cof:hasRegion>
    <cof:hasMonths rdf:datatype="http://www.w3.org/2001/XMLSchema#string">April - September</cof:hasMonths>
    <cof:hasVolumeShare rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3% of global production</cof:hasVolumeShare>
    <cof:hasProcessingMethods rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fully Washed</cof:hasProcessingMethods>
    <cof:hasKeyVarieties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Typica, Caturra, Bourbon, Catimor</cof:hasKeyVarieties>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Major organic coffee producer (top 5 globally). Smallholder farms at 1,200-2,000m altitude. Growing specialty reputation. Fair Trade and organic certifications widespread.</cof:hasDescription>
  </rdf:Description>
