  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Brazil_Main_Harvest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Season/Harvest"/>
    <rdfs:label xml:lang="ko">브라질 메인 수확기</rdfs:label>
    <rdfs:label xml:lang="en">Brazil Main Harvest (May-Sep)</rdfs:label>
    <rdfs:comment xml:lang="en">Largest harvest globally; natural Arabica and Robusta; peak Jun-Aug</rdfs:comment>
    <cof:hasRegion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minas Gerais, Sao Paulo, Espirito Santo, Bahia</cof:hasRegion>
    <cof:hasMonths rdf:datatype="http://www.w3.org/2001/XMLSchema#string">May - September</cof:hasMonths>
    <cof:hasVolumeShare rdf:datatype="http://www.w3.org/2001/XMLSchema#string">35% of global production</cof:hasVolumeShare>
    <cof:hasProcessingMethods rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Natural (dry), Pulped Natural</cof:hasProcessingMethods>
    <cof:hasKeyVarieties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mundo Novo, Catuai, Bourbon, Conilon (Robusta)</cof:hasKeyVarieties>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">World's largest coffee harvest. Brazil produces 55-65 million bags/year. Cerrado and Mogiana regions produce premium naturals. Mechanized harvesting common in flat terrain.</cof:hasDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Sustainability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
