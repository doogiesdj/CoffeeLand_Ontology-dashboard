  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Vietnam_Robusta_Harvest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Season/Harvest"/>
    <rdfs:label xml:lang="ko">베트남 로부스타 수확기</rdfs:label>
    <rdfs:label xml:lang="en">Vietnam Robusta Harvest (Oct-Mar)</rdfs:label>
    <rdfs:comment xml:lang="en">World largest Robusta harvest; peak Nov-Jan; mostly dry-processed</rdfs:comment>
    <cof:hasRegion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Central Highlands: Dak Lak, Lam Dong, Gia Lai, Dak Nong</cof:hasRegion>
    <cof:hasMonths rdf:datatype="http://www.w3.org/2001/XMLSchema#string">October - March</cof:hasMonths>
    <cof:hasVolumeShare rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16% of global production (world #2)</cof:hasVolumeShare>
    <cof:hasProcessingMethods rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Natural (dry-processed)</cof:hasProcessingMethods>
    <cof:hasKeyVarieties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Robusta (Coffea canephora)</cof:hasKeyVarieties>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">World's largest Robusta harvest. Vietnam produces 28-32 million bags/year, 95%+ Robusta. Used primarily for instant coffee and espresso blends. Rapidly growing specialty Arabica from Da Lat.</cof:hasDescription>
  </rdf:Description>
