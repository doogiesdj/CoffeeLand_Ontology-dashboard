    <cof:hasGrowthTrend rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Growing 8-10% annually</cof:hasGrowthTrend>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ready-to-drink canned and bottled coffee. Japan pioneered with UCC and Boss Coffee. US market led by Starbucks bottled Frappuccino. Cold brew RTD is fastest-growing sub-segment.</cof:hasDescription>
  </rdf:Description>
