# ================================================================
# 10. PosSystem 글로벌 + 국내 POS 서비스 보강 (2026-08 리서치 기반)
#    기존 0개 인스턴스(대시보드에는 데모 4개만 임시 표시)였던 것을
#    전 세계 주요 POS 12개 + 한국 국내 POS/VAN 8개, 총 20개로 보강.
# ================================================================

cof:hasProvider a owl:DatatypeProperty ; rdfs:domain cof:PosSystem ; rdfs:range xsd:string ;
    rdfs:label "제공 업체"@ko ; rdfs:label "Provider"@en .
cof:hasMonthlyFee a owl:DatatypeProperty ; rdfs:domain cof:PosSystem ; rdfs:range xsd:string ;
    rdfs:label "월 이용료"@ko ; rdfs:label "Monthly Fee"@en .
cof:hasTransactionFee a owl:DatatypeProperty ; rdfs:domain cof:PosSystem ; rdfs:range xsd:string ;
    rdfs:label "거래 수수료"@ko ; rdfs:label "Transaction Fee"@en .
cof:hasFeatures a owl:DatatypeProperty ; rdfs:domain cof:PosSystem ; rdfs:range xsd:string ;
    rdfs:label "주요 기능"@ko ; rdfs:label "Key Features"@en .

# --- 글로벌 POS (12) ---

cof:POS_Square a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "Square for Restaurants"@en ;
    cof:hasProvider "Square Inc."^^xsd:string ; cof:hasMonthlyFee "$60"^^xsd:string ; cof:hasTransactionFee "2.6%+10¢"^^xsd:string ;
    cof:hasFeatures "Inventory Management, Staff Scheduling, Customer Analytics, Built-in Loyalty Program"^^xsd:string ;
    cof:hasOriginCountry "USA"^^xsd:string ;
    cof:hasDescription "소규모 카페·레스토랑에 널리 쓰이는 올인원 POS. 약정 없이 투명한 건당 수수료제."^^xsd:string .

cof:POS_Toast a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "Toast POS"@en ;
    cof:hasProvider "Toast Inc."^^xsd:string ; cof:hasMonthlyFee "$69"^^xsd:string ; cof:hasTransactionFee "2.49%+15¢"^^xsd:string ;
    cof:hasFeatures "Online Ordering, Table Management, Kitchen Display System, Payroll Integration"^^xsd:string ;
    cof:hasOriginCountry "USA"^^xsd:string ;
    cof:hasDescription "안드로이드 기반 레스토랑 특화 POS. 메뉴·모디파이어 관리가 강력해 푸드 메뉴가 있는 카페에 적합."^^xsd:string .

cof:POS_Clover a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "Clover"@en ;
    cof:hasProvider "Clover Network (Fiserv)"^^xsd:string ; cof:hasMonthlyFee "Varies by processor"^^xsd:string ; cof:hasTransactionFee "Varies by processor"^^xsd:string ;
    cof:hasFeatures "Custom App Market, Flexible Hardware, Employee Management, Multi-Processor Support"^^xsd:string ;
    cof:hasOriginCountry "USA"^^xsd:string ;
    cof:hasDescription "자체 하드웨어와 앱마켓 확장이 특징. 가격은 Clover가 아닌 재판매 프로세서가 결정."^^xsd:string .

cof:POS_Lightspeed a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "Lightspeed Restaurant"@en ;
    cof:hasProvider "Lightspeed Commerce"^^xsd:string ; cof:hasMonthlyFee "$69–$399"^^xsd:string ; cof:hasTransactionFee "Custom (integrated payments)"^^xsd:string ;
    cof:hasFeatures "Advanced Inventory, Menu Engineering, Multi-location Reporting, CRM"^^xsd:string ;
    cof:hasOriginCountry "Canada"^^xsd:string ;
    cof:hasDescription "단일 매장부터 다점포 리테일+F&B 체인까지 확장 가능한 강력한 재고관리형 POS."^^xsd:string .

cof:POS_TouchBistro a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "TouchBistro"@en ;
    cof:hasProvider "TouchBistro Inc."^^xsd:string ; cof:hasMonthlyFee "$69"^^xsd:string ; cof:hasTransactionFee "Custom (integrated payments)"^^xsd:string ;
    cof:hasFeatures "Table Management, Menu Management, Staff Scheduling, Offline Mode"^^xsd:string ;
    cof:hasOriginCountry "Canada"^^xsd:string ;
    cof:hasDescription "iPad 기반 레스토랑 POS. 오프라인 모드로 인터넷 장애 중에도 운영 가능."^^xsd:string .

cof:POS_Shopify a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "Shopify POS"@en ;
    cof:hasProvider "Shopify Inc."^^xsd:string ; cof:hasMonthlyFee "$29–$299"^^xsd:string ; cof:hasTransactionFee "2.4%–2.6%+10¢"^^xsd:string ;
    cof:hasFeatures "Omnichannel Retail, Inventory Sync, E-commerce Integration, Multi-location Support"^^xsd:string ;
    cof:hasOriginCountry "Canada"^^xsd:string ;
    cof:hasDescription "Shopify 이커머스 플랫폼을 오프라인 매장까지 확장, 온오프라인 재고를 통합 관리."^^xsd:string .

cof:POS_PayPalZettle a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "PayPal Zettle"@en ;
    cof:hasProvider "PayPal Holdings"^^xsd:string ; cof:hasMonthlyFee "Free"^^xsd:string ; cof:hasTransactionFee "2.29%+9¢"^^xsd:string ;
    cof:hasFeatures "Mobile Card Reader, Invoicing, Inventory Tracking, No Contract"^^xsd:string ;
    cof:hasOriginCountry "Sweden/USA"^^xsd:string ;
    cof:hasDescription "구 iZettle. 월 이용료 없이 건당 수수료만 부과하는 모바일 POS."^^xsd:string .

cof:POS_SumUp a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "SumUp"@en ;
    cof:hasProvider "SumUp Inc."^^xsd:string ; cof:hasMonthlyFee "Free"^^xsd:string ; cof:hasTransactionFee "2.6%+10¢"^^xsd:string ;
    cof:hasFeatures "Mobile Card Reader, Online Store, Invoicing, Low-cost Hardware"^^xsd:string ;
    cof:hasOriginCountry "UK/Germany"^^xsd:string ;
    cof:hasDescription "월 이용료 없는 저가형 카드리더기. 소규모 독립 카페·마켓 노점에서 인기."^^xsd:string .

cof:POS_Revel a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "Revel Systems"@en ;
    cof:hasProvider "Revel Systems"^^xsd:string ; cof:hasMonthlyFee "$99+"^^xsd:string ; cof:hasTransactionFee "Custom (integrated payments)"^^xsd:string ;
    cof:hasFeatures "iPad POS, Kitchen Display, Loyalty Program, Franchise Management"^^xsd:string ;
    cof:hasOriginCountry "USA"^^xsd:string ;
    cof:hasDescription "다점포·프랜차이즈 운영에 특화된 엔터프라이즈급 iPad POS."^^xsd:string .

cof:POS_Loyverse a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "Loyverse POS"@en ;
    cof:hasProvider "Loyverse LLC"^^xsd:string ; cof:hasMonthlyFee "Free (core POS)"^^xsd:string ; cof:hasTransactionFee "Depends on payment processor"^^xsd:string ;
    cof:hasFeatures "Real-time Inventory, Employee Management, Loyalty Program, Free Base Plan"^^xsd:string ;
    cof:hasOriginCountry "Latvia/UK"^^xsd:string ;
    cof:hasDescription "핵심 POS 기능은 무료이고 직원관리·고급 재고 등은 유료 애드온. 신흥시장 소규모 카페에서 인기."^^xsd:string .

cof:POS_Poster a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "Poster POS"@en ;
    cof:hasProvider "Poster POS"^^xsd:string ; cof:hasMonthlyFee "$26+"^^xsd:string ; cof:hasTransactionFee "Depends on payment processor"^^xsd:string ;
    cof:hasFeatures "Unlimited Employees, Recipe/Ingredient Costing, Sales Analytics, Offline Mode"^^xsd:string ;
    cof:hasOriginCountry "Cyprus/Ukraine"^^xsd:string ;
    cof:hasDescription "레시피·재료 원가 추적 기능을 내장한 레스토랑 특화 POS."^^xsd:string .

cof:POS_Korona a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "KORONA POS"@en ;
    cof:hasProvider "COMBASE USA"^^xsd:string ; cof:hasMonthlyFee "Subscription-based"^^xsd:string ; cof:hasTransactionFee "No per-transaction fee"^^xsd:string ;
    cof:hasFeatures "Multi-location Inventory, Franchise Support, Custom Reporting, Contract-Free"^^xsd:string ;
    cof:hasOriginCountry "USA/Germany"^^xsd:string ;
    cof:hasDescription "건당 수수료 없이 구독료만 부과하는 방식. 다점포 리테일·커피 체인에 적합."^^xsd:string .

# --- 국내(한국) POS/VAN (8) ---

cof:POS_PayHere a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "페이히어 (PayHere)"@ko ; rdfs:label "PayHere"@en ;
    cof:hasProvider "페이히어(주)"^^xsd:string ; cof:hasMonthlyFee "무료 단말기 제공"^^xsd:string ; cof:hasTransactionFee "결제 건당 카드사 수수료"^^xsd:string ;
    cof:hasFeatures "선불/후불 결제, 테이블오더, 웨이팅 관리, 카드 가맹점 가입 지원"^^xsd:string ;
    cof:hasOriginCountry "대한민국"^^xsd:string ;
    cof:hasDescription "카페·식당 특화 국내 POS. 카드단말기를 무료로 제공하고 가맹점 등록을 대행해준다."^^xsd:string .

cof:POS_TOrder a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "티오더 (T Order)"@ko ; rdfs:label "T Order"@en ;
    cof:hasProvider "㈜티오더"^^xsd:string ; cof:hasMonthlyFee "₩24,000/대 (3년 약정 기준)"^^xsd:string ; cof:hasTransactionFee "고정 이용료제 (PG 수수료 별도 부과 없음)"^^xsd:string ;
    cof:hasFeatures "테이블오더, 30개 이상 포스사 자동 연동, 매장관리, AI 추천(티오더GPT)"^^xsd:string ;
    cof:hasOriginCountry "대한민국"^^xsd:string ;
    cof:hasDescription "국내 테이블오더 시장 점유율 1위. 정액 이용료 방식으로 과금하며 업계에서 가장 폭넓은 포스사 연동을 지원한다."^^xsd:string .

cof:POS_DodoPoint a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "도도포인트 (DodoPoint)"@ko ; rdfs:label "DodoPoint"@en ;
    cof:hasProvider "스포카(Spoca)"^^xsd:string ; cof:hasMonthlyFee "₩10,000~50,000 (메시지 발송 요금제별)"^^xsd:string ; cof:hasTransactionFee "N/A (CRM/메시징 서비스)"^^xsd:string ;
    cof:hasFeatures "고객 CRM, 적립/쿠폰 관리, 카페 특화 마케팅, POS 연동"^^xsd:string ;
    cof:hasOriginCountry "대한민국"^^xsd:string ;
    cof:hasDescription "카페 재방문 고객 관리에 특화된 국내 대표 CRM 겸 포스 연동 서비스."^^xsd:string .

cof:POS_POSBANK a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "포스뱅크 (POSBANK)"@ko ; rdfs:label "POSBANK"@en ;
    cof:hasProvider "㈜포스뱅크"^^xsd:string ; cof:hasMonthlyFee "하드웨어 1회 구매형"^^xsd:string ; cof:hasTransactionFee "N/A (단말기 제조사)"^^xsd:string ;
    cof:hasFeatures "POS 단말기 제조, 키오스크, 이디야·빽다방·투썸플레이스 공급, 맥도날드 해외 공급"^^xsd:string ;
    cof:hasOriginCountry "대한민국"^^xsd:string ;
    cof:hasDescription "국내 POS·키오스크 시장 점유율 54%로 1위인 하드웨어 제조사. 해외에서는 맥도날드 공식 POS 공급사로도 등록되어 있다."^^xsd:string .

cof:POS_KICC a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "한국정보통신 (KICC)"@ko ; rdfs:label "KICC"@en ;
    cof:hasProvider "한국정보통신㈜"^^xsd:string ; cof:hasMonthlyFee "VAN 수수료 기반"^^xsd:string ; cof:hasTransactionFee "건당 정액 VAN 수수료"^^xsd:string ;
    cof:hasFeatures "VAN/PG 통합 결제대행, 신용카드 조회 서비스, 오프라인 가맹점 결제망"^^xsd:string ;
    cof:hasOriginCountry "대한민국"^^xsd:string ;
    cof:hasDescription "국내 대표 VAN사 중 하나로 오프라인 카드결제망을 운영하며 PG 사업도 병행한다."^^xsd:string .

cof:POS_NICE a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "나이스정보통신 (NICE)"@ko ; rdfs:label "NICE Information Communications"@en ;
    cof:hasProvider "나이스정보통신㈜"^^xsd:string ; cof:hasMonthlyFee "VAN 수수료 기반"^^xsd:string ; cof:hasTransactionFee "건당 정액 VAN 수수료"^^xsd:string ;
    cof:hasFeatures "소액결제 특화, 편의점·프랜차이즈 가맹점망, 국내 밴 시장 점유율 1위(16.1%)"^^xsd:string ;
    cof:hasOriginCountry "대한민국"^^xsd:string ;
    cof:hasDescription "국내 밴(VAN) 시장 점유율 1위 기업으로, 편의점 등 소액결제 가맹점 비중이 높다."^^xsd:string .

cof:POS_Smartro a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "스마트로 (Smartro)"@ko ; rdfs:label "Smartro"@en ;
    cof:hasProvider "㈜스마트로"^^xsd:string ; cof:hasMonthlyFee "VAN 수수료 기반"^^xsd:string ; cof:hasTransactionFee "건당 정액 VAN 수수료"^^xsd:string ;
    cof:hasFeatures "카드결제 VAN, 가맹점 모집, POS 단말기 유지보수"^^xsd:string ;
    cof:hasOriginCountry "대한민국"^^xsd:string ;
    cof:hasDescription "국내 밴 시장 점유율 약 11.6%를 차지하는 결제 대행사."^^xsd:string .

cof:POS_KIS a owl:NamedIndividual, cof:PosSystem ;
    rdfs:label "KIS정보통신"@ko ; rdfs:label "KIS Information Communications"@en ;
    cof:hasProvider "KIS정보통신㈜"^^xsd:string ; cof:hasMonthlyFee "VAN 수수료 기반"^^xsd:string ; cof:hasTransactionFee "건당 정액 VAN 수수료"^^xsd:string ;
    cof:hasFeatures "POS 단말기 임대/판매, 오프라인 결제망, 가맹점 관리"^^xsd:string ;
    cof:hasOriginCountry "대한민국"^^xsd:string ;
    cof:hasDescription "국내 밴 시장 점유율 약 10.6%의 결제 인프라 기업."^^xsd:string .


# ================================================================
# 11. CertificationBody 보강 (4개 → 9개)
#    8-2에서 추가된 Certification 6종(USDA_Organic/Bird_Friendly/
#    CAFE_Practices/Global_Coffee_Platform_Baseline/Demeter_Biodynamic/
#    Q_Arabica_Certified) 중 실제 발급기관(issuesCertification) 연결이
#    누락된 5종에 대해 CertificationBody 인스턴스를 조사해 추가함.
#    (주의: cof:USDA_Organic 은 기존 RDF에 CertificationBody로도 존재하는
#     레거시 네이밍 중복이 있어, 신규 Body는 별도 CB_ 접두어로 분리함)
# ================================================================

cof:hasParentOrganization a owl:DatatypeProperty ; rdfs:domain cof:CertificationBody ; rdfs:range xsd:string ;
    rdfs:label "상위/모기관"@ko ; rdfs:label "Parent Organization"@en .

cof:CB_SmithsonianMBC a owl:NamedIndividual, cof:CertificationBody ;
    rdfs:label "스미소니언 철새센터"@ko ; rdfs:label "Smithsonian Migratory Bird Center"@en ;
    cof:hasCity "Washington, D.C."^^xsd:string ; cof:hasFoundedYear "1991"^^xsd:integer ;
    cof:issuesCertification cof:Bird_Friendly ;
    rdfs:comment "스미소니언 국립동물원 산하 철새 보전 연구기관. 1997년 Bird Friendly 인증을 만들어 다층 그늘재배·수종 다양성을 요구하는 가장 엄격한 그늘재배 기준을 관리한다."@ko .

cof:CB_SCSGlobalServices a owl:NamedIndividual, cof:CertificationBody ;
    rdfs:label "SCS 글로벌 서비스"@ko ; rdfs:label "SCS Global Services"@en ;
    cof:hasCity "Emeryville, California"^^xsd:string ; cof:hasFoundedYear "1984"^^xsd:integer ;
    cof:issuesCertification cof:CAFE_Practices ;
    rdfs:comment "미국 캘리포니아 소재 제3자 검증기관. 2004년 스타벅스·컨서베이션 인터내셔널과 공동으로 C.A.F.E. Practices 기준을 개발해 검증을 수행해왔다."@ko .

cof:CB_CQI a owl:NamedIndividual, cof:CertificationBody ;
    rdfs:label "커피품질연구소"@ko ; rdfs:label "Coffee Quality Institute (CQI)"@en ;
    cof:hasCity "Santa Ana, California"^^xsd:string ; cof:hasFoundedYear "1996"^^xsd:integer ;
    cof:issuesCertification cof:Q_Arabica_Certified ;
    rdfs:comment "SCA(스페셜티커피협회)에서 분리된 비영리 기관으로 전 세계 Q그레이더를 양성·인증하며, Q Arabica/Q Robusta 품질 인증 체계를 운영한다."@ko .

cof:CB_DemeterInternational a owl:NamedIndividual, cof:CertificationBody ;
    rdfs:label "데메터 인터내셔널"@ko ; rdfs:label "Demeter International"@en ;
    cof:hasCity "Darmstadt, Germany"^^xsd:string ; cof:hasFoundedYear "1928"^^xsd:integer ;
    cof:issuesCertification cof:Demeter_Biodynamic ;
    rdfs:comment "루돌프 슈타이너의 인지학적 농법을 계승해 1928년 설립된 세계 최초의 생태농업 인증기구. 50여 개국에 지부를 두고 바이오다이나믹 인증을 관리한다."@ko .

cof:CB_GCPSecretariat a owl:NamedIndividual, cof:CertificationBody ;
    rdfs:label "글로벌커피플랫폼 사무국"@ko ; rdfs:label "Global Coffee Platform Secretariat"@en ;
    cof:hasCity "Bonn, Germany"^^xsd:string ; cof:hasFoundedYear "2016"^^xsd:integer ;
    cof:hasParentOrganization "4C Association 전환 출범"^^xsd:string ;
    cof:issuesCertification cof:Global_Coffee_Platform_Baseline ;
    rdfs:comment "본(Bonn)에 사무국을 둔 다자간 지속가능성 플랫폼. Baseline Common Code는 거래량 기준 세계 최대 규모급 지속가능 커피 인증 중 하나다."@ko .


# ================================================================
# 12. Equipment 보강 — EspressoMachine/Grinder/RoasterMachine/
#     IceMaker/WaterFilter (2026-08 리서치 기반, 실존 브랜드/모델)
#     각 신규 장비에는 매칭되는 EquipmentSupplier(공급사)도 함께 추가.
# ================================================================

cof:hasPriceUSD a owl:DatatypeProperty ; rdfs:domain cof:Equipment ; rdfs:range xsd:string ;
    rdfs:label "가격대(USD)"@ko ; rdfs:label "Price Range (USD)"@en .
cof:hasYearIntroduced a owl:DatatypeProperty ; rdfs:domain cof:Equipment ; rdfs:range xsd:gYear ;
    rdfs:label "출시 연도"@ko ; rdfs:label "Year Introduced"@en .
cof:hasCapacitySpec a owl:DatatypeProperty ; rdfs:domain cof:Equipment ; rdfs:range xsd:string ;
    rdfs:label "용량/처리량 사양"@ko ; rdfs:label "Capacity Specification"@en .

# --- EspressoMachine +5 ---

cof:EM_Faema_E71 a owl:NamedIndividual, cof:EspressoMachine ;
    rdfs:label "파에마 E71"@ko ; rdfs:label "Faema E71"@en ;
    cof:hasModel "Faema E71"^^xsd:string ; cof:hasManufacturer "Faema"^^xsd:string ;
    cof:hasCountry "Italy"^^xsd:string ; cof:hasPowerWatt "3000"^^xsd:integer ;
    cof:hasPriceUSD "$9,000-12,000"^^xsd:string ; cof:hasYearIntroduced "2015"^^xsd:gYear ;
    rdfs:comment "1961년 최초의 수평보일러 자동 그룹헤드 머신 'Faema E61'을 발명한 밀라노 브랜드의 현행 플래그십. E61은 이후 반세기 넘게 업계 표준 그룹헤드 설계의 원형이 되었다."@ko .

cof:EM_Rancilio_Classe9 a owl:NamedIndividual, cof:EspressoMachine ;
    rdfs:label "란칠리오 클라세 9"@ko ; rdfs:label "Rancilio Classe 9"@en ;
    cof:hasModel "Rancilio Classe 9 USB"^^xsd:string ; cof:hasManufacturer "Rancilio"^^xsd:string ;
    cof:hasCountry "Italy"^^xsd:string ; cof:hasPowerWatt "5200"^^xsd:integer ;
    cof:hasPriceUSD "$15,000-20,000"^^xsd:string ; cof:hasYearIntroduced "2018"^^xsd:gYear ;
    rdfs:comment "1927년 설립된 밀라노 인근 빌라스탄자 소재 브랜드. USB 포트를 통한 샷 데이터 로깅과 그룹별 개별 온도제어(PID)를 지원하는 상업용 3~4그룹 머신."@ko .

cof:EM_VictoriaArduino_EagleOne a owl:NamedIndividual, cof:EspressoMachine ;
    rdfs:label "빅토리아 아르두이노 이글원"@ko ; rdfs:label "Victoria Arduino Eagle One"@en ;
    cof:hasModel "Eagle One Volumetric"^^xsd:string ; cof:hasManufacturer "Victoria Arduino"^^xsd:string ;
    cof:hasCountry "Italy"^^xsd:string ; cof:hasPowerWatt "4500"^^xsd:integer ;
    cof:hasPriceUSD "$16,000-22,000"^^xsd:string ; cof:hasYearIntroduced "2016"^^xsd:gYear ;
    rdfs:comment "1905년 토리노에서 설립, 현재 Gruppo Cimbali 소속. 자체 개발한 T3 온도안정화 시스템으로 추출 온도 편차를 ±0.5°C 이내로 유지하는 것이 특징."@ko .

cof:EM_Slayer_SteamEP a owl:NamedIndividual, cof:EspressoMachine ;
    rdfs:label "슬레이어 스팀 EP"@ko ; rdfs:label "Slayer Steam EP"@en ;
    cof:hasModel "Slayer Steam EP"^^xsd:string ; cof:hasManufacturer "Slayer Espresso"^^xsd:string ;
    cof:hasCountry "USA"^^xsd:string ; cof:hasPowerWatt "4000"^^xsd:integer ;
    cof:hasPriceUSD "$18,000-24,000"^^xsd:string ; cof:hasYearIntroduced "2009"^^xsd:gYear ;
    rdfs:comment "시애틀 기반 브랜드로 레버형 유량 제어를 통한 '프리 푸어(pre-pour)' 압력 프로파일링을 최초로 상용화, 서드웨이브 스페셜티 카페들 사이에서 대표적 프리미엄 머신으로 자리잡음."@ko .

cof:EM_Sanremo_CafeRacer a owl:NamedIndividual, cof:EspressoMachine ;
    rdfs:label "산레모 카페 레이서"@ko ; rdfs:label "Sanremo Café Racer"@en ;
    cof:hasModel "Café Racer"^^xsd:string ; cof:hasManufacturer "Sanremo Coffee Machines"^^xsd:string ;
    cof:hasCountry "Italy"^^xsd:string ; cof:hasPowerWatt "3500"^^xsd:integer ;
    cof:hasPriceUSD "$10,000-14,000"^^xsd:string ; cof:hasYearIntroduced "2017"^^xsd:gYear ;
    rdfs:comment "레트로 모터사이클 디자인 언어를 접목한 외관으로 유명한 밀라노 인근 브랜드. 그룹별 독립 PID 온도제어를 갖춘 3그룹 상업용 머신."@ko .

# --- Grinder +4 ---

cof:GR_Mahlkonig_Peak a owl:NamedIndividual, cof:Grinder ;
    rdfs:label "말콩 피크"@ko ; rdfs:label "Mahlkönig Peak"@en ;
    cof:hasModel "Peak"^^xsd:string ; cof:hasManufacturer "Mahlkönig"^^xsd:string ;
    cof:hasCountry "Germany"^^xsd:string ; cof:hasPriceUSD "$3,500-4,200"^^xsd:string ;
    cof:hasYearIntroduced "2019"^^xsd:gYear ;
    rdfs:comment "1924년 함부르크에서 창업한 브랜드의 고회전(83mm) 플랫버 그라인더. 단시간 대량 추출이 필요한 고회전 매장용으로 설계됨."@ko .

cof:GR_Ditting_KR804 a owl:NamedIndividual, cof:Grinder ;
    rdfs:label "디팅 KR804"@ko ; rdfs:label "Ditting KR804"@en ;
    cof:hasModel "KR804"^^xsd:string ; cof:hasManufacturer "Ditting"^^xsd:string ;
    cof:hasCountry "Switzerland"^^xsd:string ; cof:hasPriceUSD "$2,800-3,400"^^xsd:string ;
    rdfs:comment "1948년 설립된 스위스 바헨뷜라흐 소재 정밀기계 브랜드. 64mm 원추형(conical) 버를 사용해 대용량 드립·필터 추출용으로 널리 쓰임."@ko .

cof:GR_Fiorenzato_F64 a owl:NamedIndividual, cof:Grinder ;
    rdfs:label "피오렌자토 F64"@ko ; rdfs:label "Fiorenzato F64 Evo"@en ;
    cof:hasModel "F64 Evo"^^xsd:string ; cof:hasManufacturer "Fiorenzato"^^xsd:string ;
    cof:hasCountry "Italy"^^xsd:string ; cof:hasPriceUSD "$1,800-2,300"^^xsd:string ;
    rdfs:comment "1968년 파도바에서 설립. 64mm 플랫버와 자석식 도징 커플러를 갖춘 스페셜티 에스프레소용 그라인더로 다수의 바리스타 챔피언십에서 사용됨."@ko .

cof:GR_Comandante_C40 a owl:NamedIndividual, cof:Grinder ;
    rdfs:label "코만단테 C40"@ko ; rdfs:label "Comandante C40 MK4"@en ;
    cof:hasModel "C40 MK4 Nitro Blade"^^xsd:string ; cof:hasManufacturer "Comandante"^^xsd:string ;
    cof:hasCountry "Germany"^^xsd:string ; cof:hasPriceUSD "$220-280"^^xsd:string ;
    cof:hasYearIntroduced "2013"^^xsd:gYear ;
    rdfs:comment "수동 핸드 그라인더 카테고리의 사실상 표준. 필터·핸드드립을 중시하는 가정용/트래블 시장에서 압도적 인지도를 가짐."@ko .

# --- RoasterMachine +3 ---

cof:RM_Diedrich_IR12 a owl:NamedIndividual, cof:RoasterMachine ;
    rdfs:label "디드리히 IR-12"@ko ; rdfs:label "Diedrich IR-12"@en ;
    cof:hasModel "IR-12"^^xsd:string ; cof:hasManufacturer "Diedrich Manufacturing"^^xsd:string ;
    cof:hasCountry "USA"^^xsd:string ; cof:hasCapacitySpec "약 5.4kg/batch"^^xsd:string ;
    rdfs:comment "아이다호 보이시 소재 브랜드로, 대류열 위주의 일반 드럼 로스터와 달리 적외선(IR) 복사열 비중을 높여 균일한 열전달을 구현한 것이 특징."@ko .

cof:RM_SanFranciscan_SF25 a owl:NamedIndividual, cof:RoasterMachine ;
    rdfs:label "샌프란시스칸 SF-25"@ko ; rdfs:label "San Franciscan SF-25"@en ;
    cof:hasModel "SF-25"^^xsd:string ; cof:hasManufacturer "San Franciscan Roaster Corp"^^xsd:string ;
    cof:hasCountry "USA"^^xsd:string ; cof:hasCapacitySpec "약 11.3kg/batch"^^xsd:string ;
    rdfs:comment "1970년대부터 이어져 온 캘리포니아 산리앤드로 소재 제조사. 소형 정밀 로스터리에서 널리 쓰이는 중용량 드럼 로스터."@ko .

cof:RM_CoffeeTech_Primo a owl:NamedIndividual, cof:RoasterMachine ;
    rdfs:label "커피테크 프리모"@ko ; rdfs:label "Coffee-Tech Primo R Series"@en ;
    cof:hasModel "Primo R15"^^xsd:string ; cof:hasManufacturer "Coffee-Tech Engineering"^^xsd:string ;
    cof:hasCountry "Israel"^^xsd:string ; cof:hasCapacitySpec "약 15kg/batch"^^xsd:string ;
    rdfs:comment "이스라엘 기반 엔지니어링사가 개발한 열풍(hot-air) 로스터 라인. 낮은 배기가스 배출과 빠른 배치 전환 속도를 앞세운다."@ko .

# --- IceMaker +2 ---

cof:IM_Manitowoc_IndigoNXT a owl:NamedIndividual, cof:IceMaker ;
    rdfs:label "마니토와 인디고 NXT"@ko ; rdfs:label "Manitowoc Indigo NXT"@en ;
    cof:hasModel "Indigo NXT IYT0500"^^xsd:string ; cof:hasManufacturer "Manitowoc Ice"^^xsd:string ;
    cof:hasCountry "USA"^^xsd:string ; cof:hasCapacitySpec "약 227kg/day"^^xsd:string ;
    rdfs:comment "위스콘신 소재 상업용 제빙기 브랜드. 필터 상태·성능을 알려주는 LED 알림 시스템(OnGuard)을 탑재한 것이 특징."@ko .

cof:IM_IceOMatic_ICE0500 a owl:NamedIndividual, cof:IceMaker ;
    rdfs:label "아이스오매틱 ICE0500"@ko ; rdfs:label "Ice-O-Matic ICE0500"@en ;
    cof:hasModel "ICE0500"^^xsd:string ; cof:hasManufacturer "Ice-O-Matic"^^xsd:string ;
    cof:hasCountry "USA"^^xsd:string ; cof:hasCapacitySpec "약 231kg/day"^^xsd:string ;
    rdfs:comment "텍사스 덴턴 소재 브랜드로 소형 매장에 적합한 자체완결형(self-contained) 큐브형 제빙기 라인으로 잘 알려져 있음."@ko .

# --- WaterFilter +2 ---

cof:WF_BWT_BestmaxPremium a owl:NamedIndividual, cof:WaterFilter ;
    rdfs:label "BWT 베스트맥스 프리미엄"@ko ; rdfs:label "BWT Bestmax Premium"@en ;
    cof:hasModel "Bestmax Premium L"^^xsd:string ; cof:hasManufacturer "BWT"^^xsd:string ;
