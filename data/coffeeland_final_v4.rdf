    <cof:hasScope rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bilateral trade liberalization with sustainability chapters</cof:hasScope>
    <cof:hasImpactOnCoffee rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Duty-free access for Colombian/Peruvian coffee into EU; includes environmental compliance requirements</cof:hasImpactOnCoffee>
    <cof:hasStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In Force</cof:hasStatus>
  </rdf:Description>
