  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Instant_Coffee_Consumer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Consumer"/>
    <rdfs:label xml:lang="ko">인스턴트 커피 소비자</rdfs:label>
    <rdfs:label xml:lang="en">Instant Coffee Consumer</rdfs:label>
    <rdfs:comment xml:lang="en">Dominant in UK Japan SE Asia; prioritizes convenience and price</rdfs:comment>
    <cof:hasMarketShare rdf:datatype="http://www.w3.org/2001/XMLSchema#string">25-30%</cof:hasMarketShare>
    <cof:hasPriceSensitivity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High</cof:hasPriceSensitivity>
    <cof:hasPreferredGrade rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standard to Commercial Grade (often Robusta blends)</cof:hasPreferredGrade>
    <cof:hasKeyMarkets rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UK, Japan, Russia, Southeast Asia, Eastern Europe</cof:hasKeyMarkets>
    <cof:hasGrowthTrend rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Declining in West, growing in Asia</cof:hasGrowthTrend>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dominant in markets where convenience trumps quality. Freeze-dried and spray-dried formats. Nescafe holds ~50% global market share. Growing premium instant segment (specialty soluble).</cof:hasDescription>
  </rdf:Description>
