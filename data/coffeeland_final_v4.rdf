  <rdf:Description rdf:about="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Fair_Trade_Minimum_Price_Indicator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/boogi/ontologies/2025/11/untitled-ontology-2#Price"/>
    <rdfs:label xml:lang="ko">공정무역 최저가격</rdfs:label>
    <rdfs:label xml:lang="en">Fairtrade Minimum Price</rdfs:label>
    <rdfs:comment xml:lang="en">Floor price: 140 cents/lb washed Arabica + 20 cents/lb social premium</rdfs:comment>
    <cof:hasExchange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fairtrade International</cof:hasExchange>
    <cof:hasContractUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N/A (floor price)</cof:hasContractUnit>
    <cof:hasPriceRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Floor: 140 cents/lb (washed Arabica) + 20 cents/lb social premium</cof:hasPriceRange>
    <cof:hasCurrency rdf:datatype="http://www.w3.org/2001/XMLSchema#string">USD</cof:hasCurrency>
    <cof:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guaranteed minimum price protecting smallholder farmers from market volatility. When market exceeds floor, farmers receive market price plus social premium.</cof:hasDescription>
    <cof:hasRelevance rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Protects 800,000+ coffee farming families worldwide</cof:hasRelevance>
  </rdf:Description>
